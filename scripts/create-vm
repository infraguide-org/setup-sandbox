      =0YYh
      -----END PGP PUBLIC KEY BLOCK-----
  - path:        /etc/apt/sources.list.d/docker.sources
    owner:       root:root
    permissions: '0644'
    content: |
      Types: deb
      URIs: https://download.docker.com/linux/ubuntu
      Suites: noble
      Components: stable
      Signed-by: /etc/apt/keyrings/docker.asc
  - path:        /etc/apt/preferences.d/docker-pin
    owner:       root:root
    permissions: '0644'
    content: |
      Package: docker-ce
      Pin: version 5:28.*
      Pin-Priority: 1001

      Package: docker-ce-cli
      Pin: version 5:28.*
      Pin-Priority: 1001
  - path:        /etc/env.json
    owner:       root:root
    permissions: '0644'
    content: |
      {
        "id":        $ID,
        "vmid":      $VMID,
        "name":      "$NAME",
        "cpu":       $CPU,
        "ram":       $RAM,
        "disks":     $DISKS_JSON,
        "netconf":   $NETCONF_JSON,
        "airgapped": "$AIRGAPPED"
      }
EOF

if [ "$AIRGAPPED" = "soft" ]
  then
  cat <<EOF >> "$VENDOR_FILE"
  - path:        /etc/profile.d/proxy.sh
    owner:       root:root
    permissions: '0644'
    content: |
      export http_proxy="http://proxy.wrx.sckt.net:3128"
      export https_proxy="http://proxy.wrx.sckt.net:3128"
      export no_proxy="localhost,127.0.0.1,.wrx.sckt.net,169.254.169.254"
      export HTTP_PROXY="http://proxy.wrx.sckt.net:3128"
      export HTTPS_PROXY="http://proxy.wrx.sckt.net:3128"
      export NO_PROXY="localhost,127.0.0.1,.wrx.sckt.net,169.254.169.254"
EOF
fi

cat <<EOF >> "$VENDOR_FILE"
  - path:        /etc/profile.d/wrx.sh
    owner:       root:root
    permissions: '0644'
    content: |
      export WRX_RAW_BASE_PATH=https://raw.githack.com/codecap/openstack-workshop/main
      export WRX_PROXY=http://proxy.wrx.sckt.net:3128
      export WRX_INFRA_NODES_GR1="dns|proxy|registry"
      export WRX_INFRA_NODES_GR2="deployment|recorder"
EOF

#
# NOTE: whether or not we wrote in a debug file with ".debug" suffix we use
#       the file without it
#
qm set $VMID --cicustom "vendor=${SNIPPET_STORAGE}:snippets/$(basename ${VENDOR_FILE/.debug/})"
qm cloudinit update $VMID

# Disks logic (Original Loop)
while read SIZE; do
    D_ID=0
    while qm config "$VMID" | grep -q "scsi$D_ID:"; do
        ((D_ID++))
    done
    qm set "$VMID" "--scsi$D_ID" "${STORAGE}:${SIZE}"
done < <(echo "$DISKS_JSON" | jq -Mr ".[]")

##############################################################################
# post steps

# Clear nameservers and search domain
qm set $VMID --nameserver   "$NAMESERVER"
qm set $VMID --searchdomain "$SEARCHDOMAIN"

# ssh keys
qm set $VMID --sshkeys <(cat ~/.ssh/authorized_keys;)

# resize the root disk
qm resize $VMID scsi0 16G

# cpu type
qm set $VMID --cpu host

# set autostart
qm set $VMID --onboot 1

# start
qm start $VMID
