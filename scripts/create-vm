#!/usr/bin/env bash
##############################################################################
# config
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
CONFIG_DIR="$SCRIPT_DIR/../conf/"
ENV_CONF="$CONFIG_DIR/env.yaml"

##############################################################################
# vars
ID_START_FROM=1000
TEMPLATE_ID=9000
#STORAGE="local-lvm"
STORAGE="local"
# STORAGE="vmdata"
NCARD_MODEL="virtio"
SNIPPET_STORAGE="local"
SNIPPET_DIR="/var/lib/vz/snippets"
IFACE_DATA_JSON=$(cat "$ENV_CONF" | yq -r '.network_conf' -j)
NAMESERVER=$(   cat $ENV_CONF | yq -r '.resolve_conf.nameservers[]'   | xargs)
SEARCHDOMAIN=$( cat $ENV_CONF | yq -r '.resolve_conf.searchdomains[]' | xargs)
CIUSER=deploy
CIPASS=deploy

mkdir -p "$SNIPPET_DIR"

if [[ ! -f "$ENV_CONF" ]]; then
    echo "Error: Configuration file $ENV_CONF not found."
    exit 1
fi
##############################################################################
# args
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --id)        ID="$2";           shift 2 ;;
        --name)      NAME="$2";         shift 2 ;;
        --cpu)       CPU="$2";          shift 2 ;;
        --ram)       RAM="$2";          shift 2 ;;
        --disks)     DISKS_JSON="$2";   shift 2 ;;
        --netconf)   NETCONF_JSON="$2"; shift 2 ;;
        --command)   COMMAND="$2";      shift 2 ;;
        --airgapped) AIRGAPPED="$2";    shift 2 ;;

        *) echo "Unknown parameter: $1"; exit 1 ;;
    esac
done

VMID=$(($ID_START_FROM + ID))
DOMAIN=${NAME#*.}
SEARCHDOMAIN="$SEARCHDOMAIN $DOMAIN"

##############################################################################
# go
VENDOR_FILE="$SNIPPET_DIR/vm-${VMID}-vendor.yaml"
# VENDOR_FILE="$SNIPPET_DIR/vm-${VMID}-vendor.yaml.debug"

qm clone $TEMPLATE_ID $VMID --name "$NAME" --storage $STORAGE --full
qm set $VMID --ciuser $CIUSER --cipassword $CIPASS --cores "$CPU" --memory "$RAM"

cat <<EOF > "$VENDOR_FILE"
#cloud-config
bootcmd:
EOF

if [[ "$AIRGAPPED" =~ ^(true|yes|soft)$ ]]
  then
  cat <<EOF >> "$VENDOR_FILE"
  - |
    cat > /etc/netplan/60-eth0-override.yaml <<EOF
    network:
      version: 2
      ethernets:
        eth0:
          activation-mode: off
    EOF
EOF
fi

#
# NOTE: at this stage we only create netplan config file to rename interfaces
#       it remains deactivated and will be applied later
#
cat <<EOF >> "$VENDOR_FILE"
  - |
    cat > /etc/netplan/70-wrx-rename-ifaces.yaml.off <<EOF
    network:
      version: 2
      ethernets:
EOF

# Iterate through the requested network interfaces
while IFS=$'\t' read -r NET_NAME MACADDR IP GW MTU; do

  # Get slot ID
  NEXT_ID=0
  while qm config "$VMID" | grep -q "net$NEXT_ID:"; do
      ((NEXT_ID++))
  done

  # Lookup 'iface' dynamically from the JSON we got via yq
  HEX_OCTET=$(echo "$MACADDR" | cut -d':' -f5)
  IDX=$((16#$HEX_OCTET))
  NET_KEY=$(echo "$IFACE_DATA_JSON" | jq -r "to_entries | sort_by(.key) | .[$IDX].key")

  TARGET_IFACE=$(echo "$IFACE_DATA_JSON" | jq -r ".\"$NET_KEY\".iface // \"\"")

  qm set $VMID --net$NEXT_ID "$NCARD_MODEL,bridge=br$NET_NAME,macaddr=$MACADDR${MTU:+,mtu=$MTU}"
  if [ -n "$IP" ]; then
      qm set $VMID --ipconfig$NEXT_ID "ip=${IP}${GW:+,gw=$GW}"
  fi

  if [[ -n "$TARGET_IFACE" && -n "$MACADDR" ]]; then
      cat <<EOF >> "$VENDOR_FILE"
        eth${NEXT_ID}:
          match:
            macaddress: "${MACADDR,,}"
          set-name: "$TARGET_IFACE"
          dhcp4: false
          dhcp6: false
          link-local: []
EOF
    fi
done < <(echo "$NETCONF_JSON" | jq -r 'to_entries[] | "\(.key)\t\(.value.macaddr // "")\t\(.value.ip // "")\t\(.value.gw // "")\t\(.value.mtu // "")"')

cat <<EOF >> "$VENDOR_FILE"
    EOF
  - chmod 600 /etc/netplan/*.yaml
  - netplan generate
  - systemctl restart systemd-networkd
EOF


# TODO: do we need this
# if [[ "$AIRGAPPED" =~ ^(soft)$ ]]
#   then
#   cat <<EOF >> "$VENDOR_FILE"
# proxy:       http://proxy.wrx.sckt.net:3128
# https_proxy: http://proxy.wrx.sckt.net:3128
# no_proxy:    localhost,127.0.0.1,.wrx.sckt.net,169.254.169.254
# EOF
# fi

if [[ "$AIRGAPPED" =~ ^(true|yes|soft)$ ]]
  then
  #
  # NOTE: this is needed for cloud-init during provisioning to
  #         - update OS
  #         - install packages
  #
  cat <<EOF >> "$VENDOR_FILE"
apt:
  proxy: http://proxy.wrx.sckt.net:3128
EOF
fi

cat <<EOF >> "$VENDOR_FILE"
package_udpate: true
packages:
  - curl
  - docker-ce
  - git
  - htop
  - httping
  - jq
  - net-tools
  - ngrep
  - nmap
  - python3-venv
  - screen
  - tcpdump
  - tree
  - vim
  - wget
  - yq
manage_etc_hosts: true
runcmd:
  - growpart  /dev/sda  1
  - resize2fs /dev/sda1
  - touch /etc/cloud/cloud-init.disabled
  - mv /etc/netplan/70-wrx-rename-ifaces.yaml.off /etc/netplan/70-wrx-rename-ifaces.yaml
  - netplan apply
  - systemctl restart systemd-timesyncd
EOF


if [ -n "$COMMAND" ]
  then
cat <<EOF >> "$VENDOR_FILE"
  - "$COMMAND"
EOF
fi


cat <<EOF >> "$VENDOR_FILE"
fs_setup:
  - device:     /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
    filesystem: ext4
    overwrite:  true
mounts:
  - [ /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1, /var/lib/docker, "ext4", "defaults,nofail", "0", "2" ]
write_files:
  - path:        /etc/systemd/timesyncd.conf
    owner:       root:root
    permissions: '0644'
    content: |
      [Time]
      NTP=10.14.0.19
  - path:        /etc/vim/vimrc.local
    owner:       root:root
    permissions: '0644'
    content:     "set paste"
  - path:        /etc/docker/daemon.json
    owner:       root:root
    permissions: '0644'
    content: |
      {
        "insecure-registries": ["registry.services.wrx.sckt.net",   "registry.wrx.sckt.net"]
      }
  - path:        /etc/apt/keyrings/docker.asc
    owner:       root:root
    permissions: '0644'
    content: |
      -----BEGIN PGP PUBLIC KEY BLOCK-----

      mQINBFit2ioBEADhWpZ8/wvZ6hUTiXOwQHXMAlaFHcPH9hAtr4F1y2+OYdbtMuth
