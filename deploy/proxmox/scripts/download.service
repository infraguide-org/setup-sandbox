[Unit]
Description=Temporary HTTPS server for downloading the bootstrap SSH keypair
After=network.target
ConditionPathExists=/infraguide/setup-sandbox/conf/download-enabled

[Service]
Type=simple
Environment=PUB_DIR=/infraguide/setup-sandbox/public
Environment=PORT=8443
Environment=TLS_CERT=/infraguide/setup-sandbox/conf/download.crt
Environment=TLS_KEY=/infraguide/setup-sandbox/conf/download.key
ExecStart=/usr/bin/python3 /infraguide/setup-sandbox/deploy/proxmox/scripts/download.py
Restart=no

[Install]
WantedBy=multi-user.target
